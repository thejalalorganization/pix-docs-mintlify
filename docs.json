{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pix",
  "description": "One place for every coding agent.",
  "colors": {
    "primary": "#a8410b",
    "light": "#f0a868",
    "dark": "#8e370a"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "fonts": {
    "heading": {
      "family": "Oxanium",
      "weight": 700
    }
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "getting-started/install",
              "getting-started/first-session",
              "getting-started/connecting-agents"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "introduction",
              "guides/sessions",
              "guides/handoffs",
              "guides/branching",
              "guides/references",
              "guides/search-and-catalog",
              "guides/projects-and-scratch",
              "guides/worktrees",
              "guides/parallel-work",
              "guides/models",
              "guides/commands-and-skills",
              "guides/surfaces",
              "guides/remote-access",
              "guides/usage-and-context"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Internals",
        "groups": [
          {
            "group": "Under the hood",
            "pages": [
              "under-the-hood/architecture",
              "under-the-hood/pix-directory",
              "under-the-hood/session-log-format",
              "under-the-hood/snapshots-and-projections",
              "under-the-hood/blobs",
              "under-the-hood/index-db",
              "under-the-hood/native-history-import",
              "under-the-hood/updates",
              "under-the-hood/privacy"
            ]
          }
        ]
      },
      {
        "tab": "Enterprise",
        "groups": [
          {
            "group": "Enterprise",
            "pages": [
              "enterprise/editions",
              "enterprise/shared-server",
              "enterprise/identity-and-access",
              "enterprise/audit-and-usage",
              "enterprise/policy"
            ]
          },
          {
            "group": "Roadmap",
            "pages": [
              "roadmap"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Download",
          "href": "https://pixcode.sh",
          "icon": "download"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/sakib/pix-docs",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/sakib/pix-docs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://pixcode.sh"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sakib"
    }
  },
  "seo": {
    "indexing": "all"
  }
}
